# Core application
APP_HOST=127.0.0.1
APP_PORT=5000
SECRET_KEY=replace-with-a-random-secret
CAMERA_ID=living_room

# Video source
USE_WEBCAM=false
WEBCAM_INDEX=0
VIDEO_SOURCE=videos/test_video.mp4

# Detection
PERSON_CONFIDENCE_THRESHOLD=0.60
MOTION_THRESHOLD=25
MOTION_MIN_AREA=1500
BLUR_SIZE_VALUE=21
COOLDOWN_SECONDS=30
RETENTION_DAYS=7

# Dashboard authentication
DASHBOARD_AUTH_ENABLED=false
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD_HASH=

# Voice assistant or IFTTT webhook
VOICE_WEBHOOK_TOKEN=replace-with-a-long-random-token

# Telegram notification
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=10

# MQTT
MQTT_ENABLED=false
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CAMERA_ID=camera1
MQTT_BASE_TOPIC=home/security/camera1
HEARTBEAT_INTERVAL_SECONDS=60
